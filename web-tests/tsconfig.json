{
  // Type check only (npm run typecheck): catches calls that do not exist in Playwright before a test runs
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts", "*.config.ts"]
}
